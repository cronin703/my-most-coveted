# Copy to .env.local for local development. None are needed for Phase 1.

# Public base URL, used for canonicals, sitemap and OG images (Phase 5)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inquiry form email (Phase 5). Without these the form logs to the console and shows success.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Cloudflare Turnstile spam protection (Phase 5)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
